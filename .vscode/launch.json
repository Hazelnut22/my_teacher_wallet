    "version": "0.2.0",
    "configurations": [

        {
            "name": "Teacher Wallet dev",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "program": "lib/main_dev.dart",
            "args": [
                "--flavor", "dev",
                "--dart-define-from-file", "dev_config.json"
            ]
        },
        {
            "name": "Teacher Wallet",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main_prod.dart",
            "args": [
                "--flavor", "prod",
                "--dart-define-from-file", "prod_config.json"
            ]
        },
        {
            "name": "Teacher Wallet (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}